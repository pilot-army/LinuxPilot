{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "DATABASE_URL_SERVERS",
        "DATABASE_URL_SERVERS_TEST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
