# =============================================================================
# LinuxPilot environment template
# Copy to .env and replace every CHANGE_ME value before starting services.
# Never commit real secrets.
# Generate local JWT keys with: node scripts/generate-dev-secrets.mjs
# =============================================================================

NODE_ENV=development

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=linuxpilot
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=linuxpilot_auth
POSTGRES_PORT=5432

# --- Auth Service ------------------------------------------------------------
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST=0.0.0.0
DATABASE_URL=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_auth
DATABASE_URL_TEST=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_auth_test
DATABASE_URL_SERVERS=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_servers
DATABASE_URL_SERVERS_TEST=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_servers_test

# RS256 access JWT. Auth Service needs the private key; Gateway needs only the public key.
JWT_ACCESS_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_ISSUER=linuxpilot-auth
JWT_AUDIENCE=linuxpilot-gateway
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_MS=5000

# Argon2id parameters (OWASP minimum recommendations).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# HMAC secret for Gateway → Auth Service requests. Rotate by setting the next
# value as SERVICE_AUTH_SECRET and the current value as SERVICE_AUTH_SECRET_PREVIOUS.
SERVICE_AUTH_SECRET=CHANGE_ME_SERVICE_AUTH_SECRET_MIN_32_CHARS
# SERVICE_AUTH_SECRET_PREVIOUS=

LOG_LEVEL=info
SESSION_CLEANUP_INTERVAL_MS=900000
SESSION_REVOKED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Optional non-interactive admin bootstrap (used by `pnpm auth:create-admin`).
# AUTH_ADMIN_EMAIL=admin@example.com
# AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Server Service ----------------------------------------------------------
SERVER_SERVICE_PORT=3002
SERVER_SERVICE_HOST=0.0.0.0

# --- API Gateway -------------------------------------------------------------
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_TIMEOUT_MS=5000
SERVER_SERVICE_URL=http://localhost:3002
SERVER_SERVICE_TIMEOUT_MS=5000
PUBLIC_GATEWAY_URL=http://localhost:3000
SSH_KEYS_MASTER_KEY=CHANGE_ME_SSH_KEYS_MASTER_KEY_MIN_32_CHARS
SSH_KEYS_MASTER_KEY_VERSION=v1
HEARTBEAT_INTERVAL_MS=30000
OFFLINE_TIMEOUT_MS=90000
ENROLLMENT_TOKEN_TTL_MS=900000
METRICS_RETENTION_DAYS=14
METRICS_CLEANUP_INTERVAL_MS=900000
METRICS_CLEANUP_BATCH_SIZE=500
STATUS_SWEEP_INTERVAL_MS=30000
AGENT_TIMESTAMP_WINDOW_MS=30000
AGENT_REQUEST_BODY_LIMIT=32768
AGENT_RATE_LIMIT=30
AGENT_RATE_LIMIT_TTL_MS=60000
# Cookie Secure flag. Must be set explicitly. Must be true in production / HTTPS.
COOKIE_SECURE=false
# Trust X-Forwarded-For only when a reverse proxy is in front of the gateway.
# Must be set explicitly. Production Compose will not default this to true.
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_TTL_MS=60000
REFRESH_RATE_LIMIT=10
REFRESH_RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_TTL_MS=60000
# In-memory only. Multiple gateway replicas do not share this limiter.
RATE_LIMIT_STORE=memory

# --- Frontend ----------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
WEB_PORT=8080
