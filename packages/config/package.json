{
  "name": "@linuxpilot/config",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test src/*.spec.ts"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@linuxpilot/tsconfig": "workspace:*",
    "@types/node": "22.10.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
