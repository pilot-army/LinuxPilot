{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "incremental": true,
    "noEmitOnError": true
  },
  "watchOptions": {
    "excludeDirectories": ["**/generated", "**/dist", "**/node_modules"]
  }
}
