{
  "name": "@linuxpilot/common",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service-auth": {
      "types": "./dist/service-auth.d.ts",
      "default": "./dist/service-auth.js"
    },
    "./agent-auth": {
      "types": "./dist/agent-auth.d.ts",
      "default": "./dist/agent-auth.js"
    }
  },
  "typesVersions": {
    "*": {
      "service-auth": [
        "dist/service-auth.d.ts"
      ],
      "agent-auth": [
        "dist/agent-auth.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test src/*.spec.ts"
  },
  "devDependencies": {
    "@linuxpilot/tsconfig": "workspace:*",
    "@types/node": "22.10.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
