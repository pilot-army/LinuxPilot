NODE_ENV=test
AUTH_SERVICE_PORT=3011
AUTH_SERVICE_HOST=127.0.0.1
DATABASE_URL=postgresql://linuxpilot:linuxpilot_test_password@localhost:5432/linuxpilot_auth_test
JWT_ACCESS_TTL=15m
JWT_ISSUER=linuxpilot-auth
JWT_AUDIENCE=linuxpilot-gateway
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_MS=5000
ARGON2_MEMORY_COST=4096
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOG_LEVEL=silent
SERVICE_AUTH_SECRET=test-service-auth-secret-min-32-chars
SESSION_CLEANUP_INTERVAL_MS=3600000
SESSION_REVOKED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
