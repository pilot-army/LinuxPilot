NODE_ENV=development
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST=0.0.0.0
DATABASE_URL=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_auth
JWT_ACCESS_PRIVATE_KEY_PATH=../../secrets/jwt-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_ISSUER=linuxpilot-auth
JWT_AUDIENCE=linuxpilot-gateway
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_MS=5000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOG_LEVEL=info
SERVICE_AUTH_SECRET=CHANGE_ME_SERVICE_AUTH_SECRET_MIN_32_CHARS
SESSION_CLEANUP_INTERVAL_MS=900000
SESSION_REVOKED_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
