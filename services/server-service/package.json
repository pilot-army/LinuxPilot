{
  "name": "@linuxpilot/server-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build && node -e \"const fs=require('fs');fs.cpSync('src/generated','dist/generated',{recursive:true})\"",
    "dev": "prisma migrate deploy && nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.ts --runInBand",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "prisma:generate": "prisma generate && node -e \"const fs=require('fs'); if (fs.existsSync('dist')) fs.cpSync('src/generated','dist/generated',{recursive:true})\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@linuxpilot/auth-contracts": "workspace:*",
    "@linuxpilot/common": "workspace:*",
    "@linuxpilot/config": "workspace:*",
    "@linuxpilot/logger": "workspace:*",
    "@linuxpilot/server-contracts": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.3.1",
    "dotenv": "16.4.7",
    "jsonwebtoken": "9.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@linuxpilot/tsconfig": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.7",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prisma": "6.3.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
