NODE_ENV=development
SERVER_SERVICE_PORT=3002
SERVER_SERVICE_HOST=0.0.0.0
DATABASE_URL=postgresql://linuxpilot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/linuxpilot_servers
JWT_ACCESS_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
JWT_ISSUER=linuxpilot-auth
JWT_AUDIENCE=linuxpilot-gateway
LOG_LEVEL=info
SERVICE_AUTH_SECRET=CHANGE_ME_SERVICE_AUTH_SECRET_MIN_32_CHARS
HEARTBEAT_INTERVAL_MS=30000
OFFLINE_TIMEOUT_MS=90000
ENROLLMENT_TOKEN_TTL_MS=900000
METRICS_RETENTION_DAYS=14
METRICS_CLEANUP_INTERVAL_MS=900000
METRICS_CLEANUP_BATCH_SIZE=500
STATUS_SWEEP_INTERVAL_MS=30000
AGENT_TIMESTAMP_WINDOW_MS=30000
AGENT_REQUEST_BODY_LIMIT=32768
EVENTS_RETENTION_DAYS=90
AGENT_MIN_SUPPORTED_VERSION=
HEALTH_HYSTERESIS_PERCENT=5
METRICS_MIN_INTERVAL_MS=5000
METRICS_MAX_FUTURE_MS=60000
METRICS_MAX_AGE_MS=3600000
OPERATION_TTL_MS=3600000
OPERATION_MAX_PARALLEL=3
BULK_MAX_SERVERS=50
PUBLIC_GATEWAY_URL=http://localhost:3000
SSH_KEYS_MASTER_KEY=CHANGE_ME_SSH_KEYS_MASTER_KEY_MIN_32_CHARS
SSH_KEYS_MASTER_KEY_VERSION=v1
