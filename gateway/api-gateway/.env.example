NODE_ENV=development
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_TIMEOUT_MS=5000
JWT_ACCESS_PUBLIC_KEY_PATH=../../secrets/jwt-public.pem
JWT_ISSUER=linuxpilot-auth
JWT_AUDIENCE=linuxpilot-gateway
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_TTL_MS=60000
REFRESH_RATE_LIMIT=10
REFRESH_RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_STORE=memory
SERVICE_AUTH_SECRET=CHANGE_ME_SERVICE_AUTH_SECRET_MIN_32_CHARS
LOG_LEVEL=info
