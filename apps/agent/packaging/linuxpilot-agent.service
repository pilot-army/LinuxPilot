[Unit]
Description=LinuxPilot agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linuxpilot
Group=linuxpilot
EnvironmentFile=-/etc/linuxpilot/agent.env
ExecStart=/usr/bin/linuxpilot-agent run
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/linuxpilot
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
