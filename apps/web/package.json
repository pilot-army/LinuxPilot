{
  "name": "@linuxpilot/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 8080",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@linuxpilot/auth-contracts": "workspace:*",
    "@linuxpilot/common": "workspace:*",
    "@linuxpilot/i18n": "workspace:*",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@linuxpilot/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "3.0.4"
  }
}
